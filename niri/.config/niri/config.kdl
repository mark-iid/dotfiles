// kb3lyb-sway — baked niri default config.
//
// This lives at /etc/niri/config.kdl, niri's SYSTEM fallback. It is NOT in
// /etc/skel on purpose: skel copies into $HOME and would collide with the real
// config stow-deployed from the dotfiles repo (DESIGN §6). A system fallback
// gives a fresh user a working session while leaving $HOME empty for stow.
//
// Keep this minimal and "sane default". Real iteration happens in the dotfiles
// repo and takes effect on `niri msg action reload-config` (DESIGN §6 test).

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
        // disable-while-typing toggle. The single marked line below is flipped by
        // scripts/dwt-toggle (waybar custom/dwt module + Mod+Shift+G); niri
        // auto-reloads on save. Committed default is OFF (line commented) so the
        // keyboard and pointer work together in games (Minecraft/Myst). Enabling it
        // makes the touchpad briefly freeze after each keypress. Don't hand-edit the
        // marked line — the toggle scripts match on its trailing marker.
        // dwt //@DWT
    }
    focus-follows-mouse
}

output "eDP-1" {
    // Framework 13 2256x1504 ~200 DPI panel. 1.35 matches the current setup
    // (DESIGN §1/§2). Wayland-native apps render sharp at this fractional scale.
    scale 1.35
}

// External display (HDMI/DP), for presenting — fill in when you first dock.
// Plug it in, run `niri msg outputs` to get the real name (e.g. "HDMI-A-1") and its
// modes, then uncomment and adjust. niri applies these on hotplug, so no kanshi is
// needed for a simple extend. position is in logical coords; eDP-1 is 1671 wide at
// scale 1.35 (2256 / 1.35), so x=1671 puts the external directly to its right.
//   NOTE: niri does not mirror outputs. For a true projector mirror, use `wl-mirror`
//   (mirror eDP-1 onto the external; not installed — `brew install wl-mirror` or add
//   it to the recipe), or just extend and drag the slides window across.
// output "HDMI-A-1" {
//     mode "1920x1080@60.000"
//     scale 1.0
//     position x=1671 y=0
// }

// HiDPI note (DESIGN §4): the compositor scale above handles native apps. The
// XWayland toolkit-scaling env vars (GDK_SCALE / QT_SCALE_FACTOR / Xft.dpi) are
// deliberately NOT set here — they are global and would double native GTK apps.
// Tune those per the operator's dotfiles via ~/.config/environment.d.

environment {
    // Force Electron/Chromium and Qt onto native Wayland where they honor it.
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland"
    MOZ_ENABLE_WAYLAND "1"
    // XWayland via niri's xwayland-satellite integration.
    DISPLAY ":0"
}

prefer-no-csd

// Screenshots land here.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

layout {
    gaps 8
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
        active-color "#7aa2f7"
        inactive-color "#505050"
    }
}

// Startup: bar, notifications, polkit agent, clipboard history + persistence, and
// the network/bluetooth tray applets. waybar's tray module stays empty without an
// SNI provider running; `nm-applet --indicator` uses the StatusNotifierItem path
// that waybar understands (plain `nm-applet` would try the dead XEmbed tray).
// XWayland is NOT spawned here: niri 26.04 starts xwayland-satellite itself; a
// second manual instance just races it. wl-clip-persist keeps the last selection
// alive after the source window closes (wlroots drops it otherwise), so pasting a
// copied URL into Firefox works. The graphical-session-bind unit (dotfiles
// systemd/) is started first: it activates graphical-session.target so
// xdg-desktop-portal comes up (dark-mode color-scheme, file pickers, screencast) —
// niri here runs as a bare command, not niri.service, so nothing else pulls it up.
spawn-at-startup "systemctl" "--user" "start" "graphical-session-bind.service"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "/usr/libexec/polkit-mate-authentication-agent-1"
spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"
spawn-at-startup "wl-clip-persist" "--clipboard" "both"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"
// Solid Norton-blue wallpaper (#0000AA), matching the tuigreet login screen and
// the KB3LYB / Norton Utilities presentation style. niri has no background of its
// own, so swaybg paints one; -c takes RRGGBB without the leading '#'.
spawn-at-startup "swaybg" "-c" "0000AA"
// EasyEffects speaker DSP for the Framework 13 (cab404/framework-dsp presets in
// ~/.var/app/.../easyeffects/output; "Gracefu's Edits" recommended). Runs as a
// background service and reapplies the last-loaded output preset every login, so
// the tinny laptop speakers get the convolver/EQ correction. --hide-window is
// required alongside --service-mode: EE restores its last window-visibility state
// on start and will pop a window otherwise, so hide it explicitly to stay in the
// background. (Do NOT chain -l/-a CLI calls at startup — those activate the app and
// re-show the window; EE reapplies the last-loaded preset on its own.)
spawn-at-startup "flatpak" "run" "com.github.wwmm.easyeffects" "--service-mode" "--hide-window"
// Idle lock runs as a user service (swayidle.service, in dotfiles systemd/): lock
// with gtklock after 5 min, DPMS the displays off after 10, lock before suspend.
// Started here at login; the caffeine toggle (Mod+Shift+C) stops/starts it. Edit
// the timings in the service unit, not here. A service means exactly one managed
// swayidle instance — no duplicate daemons or pkill races.
spawn-at-startup "systemctl" "--user" "start" "swayidle.service"

cursor {
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Terminal, launcher, lock. ghostty is the primary terminal (DESIGN §2); the
    // shell fallback launches foot when ghostty isn't present (e.g. before the image
    // baking ghostty has landed, or if it ever fails to install), so Super+Return
    // always opens *a* terminal.
    Mod+Return  { spawn "sh" "-c" "command -v ghostty >/dev/null 2>&1 && exec ghostty || exec foot"; }
    Mod+D       { spawn "fuzzel"; }
    Mod+Escape  { spawn "gtklock"; }
    // Caffeine: toggle stay-awake (stop idle-lock + block suspend) for presenting.
    Mod+Shift+C { spawn "sh" "-c" "exec $HOME/.config/niri/scripts/caffeine-toggle"; }
    // Game mode: toggle touchpad disable-while-typing (also on the waybar bar).
    Mod+Shift+G { spawn "sh" "-c" "exec $HOME/.config/niri/scripts/dwt-toggle"; }

    // Clipboard history picker.
    Mod+V { spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }

    Mod+Q       { close-window; }

    Mod+Left    { focus-column-left; }
    Mod+Right   { focus-column-right; }
    Mod+Up      { focus-window-up; }
    Mod+Down    { focus-window-down; }
    Mod+H       { focus-column-left; }
    Mod+L       { focus-column-right; }
    Mod+K       { focus-window-up; }
    Mod+J       { focus-window-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    Mod+R       { switch-preset-column-width; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Screenshots.
    Print       { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }

    // Hardware keys (Framework 13). require: brightnessctl, playerctl, wpctl.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioPlay  { spawn "playerctl" "play-pause"; }
    XF86AudioNext  { spawn "playerctl" "next"; }
    XF86AudioPrev  { spawn "playerctl" "previous"; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
