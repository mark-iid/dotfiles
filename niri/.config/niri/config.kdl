// kb3lyb-sway — baked niri default config.
//
// This lives at /etc/niri/config.kdl, niri's SYSTEM fallback. It is NOT in
// /etc/skel on purpose: skel copies into $HOME and would collide with the real
// config stow-deployed from the dotfiles repo (DESIGN §6). A system fallback
// gives a fresh user a working session while leaving $HOME empty for stow.
//
// Keep this minimal and "sane default". Real iteration happens in the dotfiles
// repo and takes effect on `niri msg action reload-config` (DESIGN §6 test).

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
        // disable-while-typing toggle. The single marked line below is flipped by
        // scripts/dwt-toggle (waybar custom/dwt module + Mod+Shift+G); niri
        // auto-reloads on save. Committed default is OFF (line commented) so the
        // keyboard and pointer work together in games (Minecraft/Myst). Enabling it
        // makes the touchpad briefly freeze after each keypress. Don't hand-edit the
        // marked line — the toggle scripts match on its trailing marker.
        dwt //@DWT
    }
    focus-follows-mouse
}

// DISPLAYS FOR BOTH MACHINES. This one config is stowed on the Framework laptop
// AND the kb3lyb shack PC, and niri silently ignores an output block whose
// connector is not present — so each machine picks up only its own blocks and
// neither needs host-conditional logic.
//
// That silent-ignore is normally a hazard (a typo in a connector name does
// nothing and reports nothing), so if a monitor misbehaves, check the name
// against `niri msg outputs` before suspecting anything else.

// Framework 13 laptop panel: 2256x1504, ~200 DPI. 1.35 renders Wayland-native
// apps sharp at this fractional scale.
output "eDP-1" {
    scale 1.35
}

// kb3lyb shack PC — Skylake HD 530 driving two desk monitors. scale 1, not
// fractional: most of that machine's GUI is Xwayland (fldigi is FLTK, chirp+wx
// is wxPython) and fractional scaling on Xwayland gives blurry upscaled bitmaps.
output "HDMI-A-1" {
    scale 1
    position x=0 y=0
}

output "DP-3" {
    scale 1
    // DP-3 sits to the LEFT of HDMI-A-1, which is the primary at the origin. A
    // left-hand monitor's x is minus its OWN width, so DP-3's right edge lands
    // on HDMI-A-1's left edge at x=0. y=0 top-aligns them; the two differ in
    // height (1080 vs 900) so the extra 180px falls off DP-3's bottom.
    position x=-1600 y=0
}

// External display (HDMI/DP), for presenting — fill in when you first dock.
// Plug it in, run `niri msg outputs` to get the real name (e.g. "HDMI-A-1") and its
// modes, then uncomment and adjust. niri applies these on hotplug, so no kanshi is
// needed for a simple extend. position is in logical coords; eDP-1 is 1671 wide at
// scale 1.35 (2256 / 1.35), so x=1671 puts the external directly to its right.
//   NOTE: niri does not mirror outputs. For a true projector mirror, use `wl-mirror`
//   (mirror eDP-1 onto the external; not installed — `brew install wl-mirror` or add
//   it to the recipe), or just extend and drag the slides window across.
// output "HDMI-A-1" {
//     mode "1920x1080@60.000"
//     scale 1.0
//     position x=1671 y=0
// }

// HiDPI note (DESIGN §4): the compositor scale above handles native apps. The
// XWayland toolkit-scaling env vars (GDK_SCALE / QT_SCALE_FACTOR / Xft.dpi) are
// deliberately NOT set here — they are global and would double native GTK apps.
// Tune those per the operator's dotfiles via ~/.config/environment.d.

environment {
    // Force Electron/Chromium and Qt onto native Wayland where they honor it.
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland"
    MOZ_ENABLE_WAYLAND "1"
    // Force the dark GTK theme session-wide. Most GTK3 apps honor
    // gtk-application-prefer-dark-theme from ~/.config/gtk-3.0/settings.ini, but
    // XFCE apps (Thunar) ignore that flag and stay light unless the dark *variant*
    // is named explicitly. Adwaita:dark is the built-in dark variant (no extra
    // theme package needed). niri exports this to everything it spawns.
    GTK_THEME "Adwaita:dark"
    // XWayland via niri's xwayland-satellite integration.
    DISPLAY ":0"
}

prefer-no-csd

// Screenshots land here.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

layout {
    gaps 2
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
        active-color "#7aa2f7"
        inactive-color "#505050"
    }
}

// Startup: bar, notifications, polkit agent, clipboard history + persistence, and
// the network/bluetooth tray applets. waybar's tray module stays empty without an
// SNI provider running; `nm-applet --indicator` uses the StatusNotifierItem path
// that waybar understands (plain `nm-applet` would try the dead XEmbed tray).
// XWayland is NOT spawned here: niri 26.04 starts xwayland-satellite itself; a
// second manual instance just races it. wl-clip-persist keeps the last selection
// alive after the source window closes (wlroots drops it otherwise), so pasting a
// copied URL into Firefox works. The graphical-session-bind unit (dotfiles
// systemd/) is started first: it activates graphical-session.target so
// xdg-desktop-portal comes up (dark-mode color-scheme, file pickers, screencast) —
// niri here runs as a bare command, not niri.service, so nothing else pulls it up.
spawn-at-startup "systemctl" "--user" "start" "graphical-session-bind.service"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "/usr/libexec/polkit-mate-authentication-agent-1"
spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"
spawn-at-startup "wl-clip-persist" "--clipboard" "both"
spawn-at-startup "nm-applet" "--indicator"
// blueman-applet dropped: the waybar `bluetooth` module shows status and opens
// blueman-manager on click for pairing (bluetoothd still runs the stack).
// Wallpaper: niri has no background of its own, so swaybg paints one. -i loads an
// image; -m fill scales it to cover the output, cropping overflow. -c sets the
// fallback color shown behind letterboxing / before the image loads.
spawn-at-startup "swaybg" "-i" "/var/home/mark/Pictures/digital-security-lock-uhd-4k-wallpaperdark.jpg" "-m" "fill" "-c" "000080"
// EasyEffects speaker DSP for the Framework 13 (cab404/framework-dsp presets in
// ~/.var/app/.../easyeffects/output; "Gracefu's Edits" recommended). Runs as a
// background service and reapplies the last-loaded output preset every login, so
// the tinny laptop speakers get the convolver/EQ correction. --hide-window is
// required alongside --service-mode: EE restores its last window-visibility state
// on start and will pop a window otherwise, so hide it explicitly to stay in the
// background. (Do NOT chain -l/-a CLI calls at startup — those activate the app and
// re-show the window; EE reapplies the last-loaded preset on its own.)
spawn-at-startup "flatpak" "run" "com.github.wwmm.easyeffects" "--service-mode" "--hide-window"
// rclone mount: InstrumentalID OneDrive (M365) at ~/OneDrive-InstrumentalID. The
// OAuth token lives in ~/.config/rclone (never in the repo); this just starts the
// user mount unit at login (systemd unit in the dotfiles systemd/ package).
spawn-at-startup "systemctl" "--user" "start" "rclone-onedrive-iid.service"
// Nextcloud desktop sync client (flatpak). --background starts it straight to the
// tray (waybar's tray module shows the SNI icon) instead of popping its window,
// mirroring EasyEffects' --hide-window. Account/creds live in the flatpak's own
// config (~/.var/app/com.nextcloud.desktopclient.nextcloud), never in the repo.
//
// LAPTOP ONLY — hence the hostname guard. On the kb3lyb shack PC Nextcloud is a
// MOUNT, never a local clone: the tree is ~88 GB against a 238 GB disk that also
// carries two rpm-ostree deployments (SETUP §6.6b). That machine gets
// rclone-nextcloud.service, started just below, and must NOT also run this client
// — the two would fight over the same ~/Nextcloud path, and the sync client would
// try to pull the whole tree down. Unlike `output` blocks, spawn-at-startup has no
// natural per-host silence, so the guard is explicit.
spawn-at-startup "sh" "-c" "[ $(hostname -s) = kb3lyb ] && exit 0; exec flatpak run com.nextcloud.desktopclient.nextcloud --background"
// kb3lyb shack PC: the rclone WebDAV mount, the counterpart to the guard above.
// Inert on the laptop, where the unit does not exist (systemctl start just fails).
spawn-at-startup "systemctl" "--user" "start" "rclone-nextcloud.service"
// Idle lock runs as a user service (swayidle.service, in dotfiles systemd/): lock
// with gtklock after 5 min, DPMS the displays off after 10, lock before suspend.
// Started here at login; the caffeine toggle (Mod+Shift+C) stops/starts it. Edit
// the timings in the service unit, not here. A service means exactly one managed
// swayidle instance — no duplicate daemons or pkill races.
spawn-at-startup "systemctl" "--user" "start" "swayidle.service"

cursor {
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
}

// Cheatsheet popup (Mod+Slash): scripts/cheatsheet launches foot with this app-id
// to render KEYBINDS.md; float it so it pops over the layout instead of tiling.
// HAM RADIO APPS — kb3lyb shack PC. Inert on the laptop, where none of these
// are installed, so they cost nothing there.
//
// Ham software is overwhelmingly floating-window software written against
// toolkits that predate tiling: WSJT-X is Qt with a waterfall that needs
// vertical room, fldigi is FLTK/X11, chirp+wx is wxPython. Tiled into columns
// the waterfall and decode list fight for the same squeezed height, and child
// dialogs get shoved into columns of their own.
//
// !! THESE app-id VALUES ARE BEST-EFFORT. niri matches Wayland app-id, and
// WM_CLASS for Xwayland clients; neither can be read off a package. A rule that
// matches nothing is SILENT. Verify with `kb3lyb-check-window-rules` on the
// shack machine, which reports any rule that matched no open window.

window-rule {
    match app-id=r#"^(?i)wsjt-?x$"#
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 900; }
}

window-rule {
    match app-id=r#"^(?i)js8call$"#
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 900; }
}

window-rule {
    match app-id=r#"^(?i)fldigi$"#
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 800; }
}

window-rule {
    match app-id=r#"^(?i)(flrig|flmsg|flamp)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(?i)(gqrx|sdrpp|sdrangel|qsstv)$"#
    open-floating true
}

// Java/Swing. Its WM_CLASS comes from the StartupWMClass in the .desktop file
// that install-sdrtrunk.sh writes — check there first if this rule does not fire.
window-rule {
    match app-id=r#"^(?i).*sdrtrunk.*$"#
    open-floating true
}

// QLog: always on DP-3 (the secondary head), always filling it. The app's layout
// — log table, band map, DX cluster, detail pane — is unusable in a half-width
// column, so it gets the whole output rather than a share of one. open-on-output
// is silently ignored if DP-3 is absent, so this stays harmless on the laptop.
// Use open-maximized instead of open-fullscreen if you want waybar kept visible.
window-rule {
    match app-id=r#"^QLog$"#
    open-on-output "DP-3"
    open-fullscreen true
}

// qlog was REMOVED from this list on 2026-08-26. It is a modern Qt app with a
// properly resizable layout and tiles fine; floating it just made it behave
// unlike every other window. The apps left here genuinely need floating — the
// rule is about toolkits that break when tiled, not about being ham software.
window-rule {
    match app-id=r#"^(?i)(chirp|klog|tqsl|gpredict|xastir)$"#
    open-floating true
}

// Wine. Every RT Systems programmer arrives as an Xwayland window whose app-id is
// derived from the .exe name, so there is no single id to match.
//
// VERIFIED 2026-08-26 with the DRCS25 installer open: niri reported its app-id as
// "drcs25_setup.exe". An earlier version of this rule matched r#"^(?i)wine$"# on
// the belief that niri matches the second WM_CLASS field (the literal "Wine"). It
// does not — it reports the INSTANCE name, which is the executable. That rule
// matched nothing, silently, exactly as kb3lyb-check-window-rules warns.
//
// So match the .exe suffix instead, which catches every Wine window whatever the
// programmer is called. "wine" is kept as an alternative for windows that do
// report the bare class. Floating is non-negotiable: Win32 apps assume a fixed
// window they position dialogs relative to.
window-rule {
    match app-id=r#"^(?i)(wine|.*\.exe)$"#
    open-floating true
}

window-rule {
    match app-id="^cheatsheet$"
    open-floating true
}

// btop system-monitor popup (click the waybar cpu/memory modules): float it.
window-rule {
    match app-id="^sysmon$"
    open-floating true
}

// Matrix screensaver: swayidle launches foot --app-id matrix-screensaver running
// cmatrix on idle (scripts/screensaver); open it fullscreen so it covers the bar.
window-rule {
    match app-id="^matrix-screensaver$"
    open-fullscreen true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }      // niri's built-in raw bind list
    Mod+Slash       { spawn "sh" "-c" "exec $HOME/.config/niri/scripts/cheatsheet"; }  // pretty KEYBINDS.md popup

    // Terminal, launcher, lock. ghostty is the primary terminal (DESIGN §2); the
    // shell fallback launches foot when ghostty isn't present (e.g. before the image
    // baking ghostty has landed, or if it ever fails to install), so Super+Return
    // always opens *a* terminal.
    Mod+Return  { spawn "sh" "-c" "command -v ghostty >/dev/null 2>&1 && exec ghostty || exec foot"; }
    Mod+D       { spawn "fuzzel"; }
    Mod+Escape  { spawn "sh" "-c" "exec gtklock -d -c $HOME/.config/gtklock/config.ini"; }  // lock now (gtklock: field + clock + fingerprint)
    // Caffeine: toggle stay-awake (stop idle-lock + block suspend) for presenting.
    Mod+Shift+C { spawn "sh" "-c" "exec $HOME/.config/niri/scripts/caffeine-toggle"; }
    // Game mode: toggle touchpad disable-while-typing (also on the waybar bar).
    Mod+Shift+G { spawn "sh" "-c" "exec $HOME/.config/niri/scripts/dwt-toggle"; }

    // --- Application launchers -------------------------------------------------
    // Mnemonic single-Mod keys. Flatpaks launch via `flatpak run`; layered apps
    // (thunar, code) by name.
    //
    // Evolution, Slack and Discord deliberately have NO individual binds. Mod+G
    // below gathers all three onto one workspace, which is how they are actually
    // used, and Mod+D (fuzzel) still launches any of them on its own — so a
    // per-app key was a third way to do something already covered twice. Dropping
    // them is what freed Mod+E, below.
    Mod+B       { spawn "flatpak" "run" "org.mozilla.firefox"; }             // Browser (Firefox)
    // LAPTOP ONLY — hostname-guarded, same trick as the Nextcloud spawn. The apps
    // are installed on the shack PC too, but are not wanted on a shortcut there;
    // Mod+D (fuzzel) still launches any of them by name. A guarded bind exists but
    // does nothing on kb3lyb, which is why KEYBINDS.md marks them laptop-only.
    Mod+C       { spawn "sh" "-c" "[ $(hostname -s) = kb3lyb ] && exit 0; exec code"; }   // Code (VS Code) — laptop only
    Mod+E       { spawn "thunar"; }                                          // Explorer (Thunar) — note Mod+Shift+E quits niri
    Mod+P       { spawn "sh" "-c" "exec $HOME/.config/niri/scripts/rbw-pick"; } // Passwords — rbw picker → clipboard (Bitwarden app can't copy on niri)
    Mod+O       { spawn "sh" "-c" "exec $HOME/.config/niri/scripts/rbw-otp"; }  // OTP — rbw TOTP code → clipboard
    Mod+M       { spawn "sh" "-c" "[ $(hostname -s) = kb3lyb ] && exit 0; exec flatpak run io.github.dweymouth.supersonic"; }  // Music (Supersonic) — laptop only
    Mod+N       { spawn "flatpak" "run" "net.cozic.joplin_desktop"; }        // Notes (Joplin)
    Mod+G       { spawn "sh" "-c" "exec $HOME/.config/niri/scripts/comms"; } // Group comms — fresh workspace: Evolution | Slack/Discord (the only bind for these three)
    Mod+T       { spawn "sh" "-c" "exec toolbox run -c voice $HOME/.local/bin/voice-dictate"; } // Talk — toggle voice dictation (whisper.cpp in `voice` toolbox → wtype into focused window)

    // --- HAM RADIO (kb3lyb shack PC) ------------------------------------------
    // Inert on the laptop: none of these are installed there, so the binds cost
    // nothing and need no hostname guard — unlike spawn-at-startup entries.
    //
    // The obvious first letters were already taken by window management (Q close,
    // F maximize, D launcher, L focus-right, P passwords), so these use free keys
    // with the mnemonic spelled out rather than a letter that merely looks right:
    Mod+W       { spawn "wsjtx"; }                                           // WSJT-X — weak-signal digital (FT8/FT4)
    Mod+S       { spawn "qlog"; }                                            // Station log (QLog)
    Mod+A       { spawn "fldigi"; }                                          // All-mode digital (fldigi)
    Mod+I       { spawn "sh" "-c" "exec $HOME/.config/niri/scripts/winlink"; } // Inbox — Winlink: VARA + pat http + browser

    Mod+Shift+T { spawn "sh" "-c" "exec $HOME/.local/bin/voice-control"; } // Talk+control — toggle niri voice command mode (Vosk grammar → niri msg action)

    // Clipboard history picker.
    Mod+V { spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }

    Mod+Q       { close-window; }

    Mod+Left    { focus-column-left; }
    Mod+Right   { focus-column-right; }
    Mod+Up      { focus-window-up; }
    Mod+Down    { focus-window-down; }
    Mod+H       { focus-column-left; }
    Mod+L       { focus-column-right; }
    Mod+K       { focus-window-up; }
    Mod+J       { focus-window-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // Mouse equivalent of the touchpad's two-finger workspace swipe. niri ships
    // these by default, but a `binds` block REPLACES the defaults wholesale
    // rather than merging, so they have to be restated here or they simply do
    // not exist — which is why nothing was bound to the wheel before.
    //
    // cooldown-ms throttles the wheel: without it one detent of a free-spinning
    // mouse wheel fires many times and flies past the workspace you wanted.
    // Shift+wheel drags the focused column along with you.
    Mod+WheelScrollDown       cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp         cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    // Horizontal wheel (or tilt) moves within the workspace's column strip.
    Mod+WheelScrollRight      cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollLeft       cooldown-ms=150 { focus-column-left; }

    // Keyboard relative equivalents — there were none, only absolute Mod+1..4.
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }

    Mod+R       { switch-preset-column-width; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Escape hatch for X11 apps that fullscreen themselves. SDL/Ren'Py games set
    // _NET_WM_STATE_FULLSCREEN on their own window and re-assert it, so the
    // fullscreen-window bind above flips niri's flag and the client stomps it back —
    // the window stays pinned to the full output, covering the bar. wmctrl clears the
    // property on the X side instead. DISPLAY :0 comes from the environment block
    // above, so this reaches xwayland-satellite's server. Note this only helps a
    // *live* client; one that has stopped consuming input still needs killing.
    Mod+Shift+X { spawn "wmctrl" "-r" ":ACTIVE:" "-b" "remove,fullscreen"; }

    // Screenshots.
    Print       { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }

    // Hardware keys (Framework 13). require: brightnessctl, playerctl, wpctl.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioPlay  { spawn "playerctl" "play-pause"; }
    XF86AudioNext  { spawn "playerctl" "next"; }
    XF86AudioPrev  { spawn "playerctl" "previous"; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
