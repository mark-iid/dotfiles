# ghostty — primary terminal for the kb3lyb-sway niri session (DESIGN §2).
# GTK4 + Wayland-native, so it honors niri's 1.35 fractional scale directly:
# font-size is points at the scaled DPI — no dpi-aware knob like foot needed.
font-family = monospace
font-size = 11

# Port of the previous foot look (Tokyo Night storm background/foreground).
background = 1a1b26
foreground = c0caf5
# Opaque: transparency made niri alpha-blend every frame, which produced a
# transient red garbled band at the window bottom on this AMD APU (GTK4 + amdgpu).
background-opacity = 1.0

cursor-style = block
cursor-style-blink = true

# Escape hatch for a terminal left in a broken mode by a dead remote session.
# .zshrc's _reset_terminal_modes precmd undoes the known leaks (mouse reporting,
# kitty keyboard protocol) at every prompt, but it deliberately cannot touch tty
# modes or the alternate screen, and a shell started before that hook existed is
# beyond its reach. This is the terminal's own full reset, so it works even when
# the keyboard is typing garbage and `fixterm` cannot be typed. Unbound by default.
keybind = ctrl+shift+r=reset
