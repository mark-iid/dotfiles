# swaylock — Norton palette (matches the greeter/wallpaper: navy #000080, #5555ff,
# cyan #00ffff, white). Deliberately NO clock: swaylock stays static while idle, so
# niri's DPMS-off (swayidle at 10 min) actually sticks overnight — unlike gtklock,
# whose live clock repainted every minute and kept the panel lit.
ignore-empty-password
daemonize

color=000080
inside-color=000080
ring-color=5555ff
line-color=000080
separator-color=000080
text-color=ffffff
key-hl-color=00ffff
bs-hl-color=ff0000

inside-ver-color=000080
ring-ver-color=5555ff
text-ver-color=ffffff

inside-clear-color=000080
ring-clear-color=00ffff
text-clear-color=000080

inside-wrong-color=000080
ring-wrong-color=ff0000
text-wrong-color=ffffff

indicator-radius=90
indicator-thickness=8
