{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(python -m py_compile *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(command -v *)"
    ],
    "deny": [
      "Read(//var/home/mark/.ssh/**)",
      "Read(//var/home/mark/.aws/**)",
      "Read(//var/home/mark/.gnupg/**)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "teammateMode": "tmux",
  "agentPushNotifEnabled": true
}
