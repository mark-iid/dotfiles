# --- Claude Code: publish only intended config/scripts, never runtime state ---
# Everything under ~/.claude is ignored by default (session transcripts, shell-env
# snapshots, cached auth tokens, plugins, backups, caches all live here); only the
# hand-maintained config + scripts below are whitelisted back in. Add new Claude
# config files explicitly (git add -f) so runtime state can never leak.
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/statusline.sh
!claude/.claude/tmux-limits.sh

# --- credentials: NEVER in this repo (belt; the pre-commit hook is the suspenders) ---
# Private keys / certs
*.pem
*.key
*.p12
*.pfx
*.gpg
id_rsa
id_ed25519
id_ecdsa
id_dsa
# Token / secret stores
**/rclone.conf
**/.credentials.json
**/credentials.json
**/.netrc
**/.git-credentials
**/*secret*
**/*token*
.env
.env.*
!.env.example

# --- general junk ---
*.log
*.swp
.DS_Store
