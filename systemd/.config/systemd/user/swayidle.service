[Unit]
Description=swayidle — idle lock + screen-off for the niri session
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Lock with swaylock after 5 min; DPMS the displays off after 10 (restored on
# activity); lock before suspend. Single source of truth for the idle policy —
# niri starts this at login and the caffeine toggle stops/starts it. swaylock (not
# gtklock) on purpose: gtklock's live clock repaints every minute and re-wakes the
# panel, so the DPMS-off never stuck overnight; swaylock is static while idle.
ExecStart=/usr/bin/swayidle -w timeout 300 'pgrep -x swaylock || swaylock -f' timeout 600 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors' before-sleep 'pgrep -x swaylock || swaylock -f'
Restart=on-failure
